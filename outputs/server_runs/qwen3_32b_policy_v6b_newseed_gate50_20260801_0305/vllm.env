# P4 new-seed Gate-50 Qwen3-32B local service settings.
# Do not put secrets in this file. LOCAL_VLLM_API_KEY is a local dummy key for the vLLM server.
export CUDA_VISIBLE_DEVICES=6,7
export LOCAL_VLLM_API_KEY=${LOCAL_VLLM_API_KEY:-local-vllm-key-change-me}
export SERVED_MODEL_NAME=qwen3-32b-local
export API_BASE_URL=http://127.0.0.1:8000/v1
export VLLM_ENDPOINTS=http://127.0.0.1:8000/v1
